ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://conditionwatch:conditionwatch@localhost:5432/conditionwatch
JWT_SECRET=replace-with-at-least-32-random-characters
PUBLIC_API_URL=http://localhost:8000
MOBILE_REDIRECT_URI=conditionwatch://auth

OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_CONDITION_MODEL=gpt-5.6-luna
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_STORE_RESPONSES=false

# Use ADC in Google Cloud. Else set one of these:
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=
# Or instead of ADC:
# FIREBASE_CREDENTIALS_JSON=/run/secrets/firebase-service-account.json

VISION_MATCH_THRESHOLD=0.82
DEFAULT_SAMPLE_INTERVAL_MS=1500
MIN_SAMPLE_INTERVAL_MS=750
CORS_ORIGINS=["http://localhost:8000"]
